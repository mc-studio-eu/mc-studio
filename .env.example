# Contact form - keep the API key server-side and never prefix it with NUXT_PUBLIC_.
NUXT_RESEND_API_KEY=
NUXT_CONTACT_FROM="MC Studio <contact@mc-studio.eu>"
NUXT_CONTACT_TO=contact@mc-studio.eu

# Client portal: private Neon connection string; SQLite is local development only.
DATABASE_URL=
# Optional GA4 read-only service account JSON (never NUXT_PUBLIC_).
GOOGLE_SERVICE_ACCOUNT_JSON=
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PORTAL_DB_PATH=.data/portal/portal.sqlite

# Brevo campaign runner - server-side only.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Mohamed de MC Studio"
BREVO_REPLY_TO=
BREVO_TEST_EMAIL=

# Private server-side Figma token (file_content:read)
FIGMA_ACCESS_TOKEN=

# Private admin token for the remote MCP endpoint (generate at least 32 random bytes).
PORTAL_MCP_TOKEN=

# Private Chrome UX Report API key for admin Core Web Vitals
CRUX_API_KEY=

# Optional private object storage. Never NUXT_PUBLIC_. Disabled until all four exist.
# R2 billing must be explicitly accepted before activating it; code creates no bucket.
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (use jurisdiction endpoint if needed).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
