{
  "name": "mc-studio-motion",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion motion design reel for MC Studio",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts McStudioReel out/mc-studio-reel.mp4",
    "render:square": "remotion render src/index.ts McStudioReelSquare out/mc-studio-reel-square.mp4",
    "render:vertical": "remotion render src/index.ts McStudioReelVertical out/mc-studio-reel-vertical.mp4",
    "still": "remotion still src/index.ts McStudioReel out/frame.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.373",
    "@remotion/google-fonts": "4.0.373",
    "@remotion/shapes": "4.0.373",
    "@remotion/noise": "4.0.373",
    "@remotion/transitions": "4.0.373",
    "remotion": "4.0.373",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
